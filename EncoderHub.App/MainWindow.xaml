<Window x:Class="EncoderHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EncoderHub.App.Views"
        Title="EncoderHub — Control Center"
        Height="780"
        Width="540"
        MinHeight="500"
        MinWidth="480"
        ResizeMode="CanResize"
        Background="#0F172A">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="#0F172A"
                  Padding="16" Margin="0,0,0,4">
        <views:DriverControlView DataContext="{Binding DriverControlVM}" />
    </ScrollViewer>
</Window>
