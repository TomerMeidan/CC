<UserControl x:Class="EncoderHub.App.Views.DriverControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:EncoderHub.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="980" d:DesignWidth="500"
             FontFamily="Segoe UI">

    <StackPanel>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--  APP HEADER                                                        -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <StackPanel Margin="4,8,4,20">
            <TextBlock Text="E N C O D E R H U B"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#6366F1"
                       FontFamily="Segoe UI"/>
            <TextBlock Text="Control Center"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#F1F5F9"
                       Margin="0,2,0,0"/>
            <TextBlock Text="Universal encoder driver platform"
                       FontSize="12"
                       Foreground="#64748B"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--  TABS                                                              -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <TabControl Style="{StaticResource ModernTabControl}">

            <!-- ───────────────────── TAB 1: CONTROL ───────────────────── -->
            <TabItem Header="Control" Style="{StaticResource ModernTabItem}">
                <StackPanel>

                    <!-- DRIVER -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="DRIVER"
                                       Style="{StaticResource HeaderTextStyle}"/>

                            <ComboBox ItemsSource="{Binding AvailableDrivers}"
                                      SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                                      Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,0,0,10">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DriverName}"
                                                   Foreground="#F1F5F9"
                                                   FontSize="14"
                                                   FontFamily="Segoe UI"
                                                   Margin="0"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem"
                                           BasedOn="{StaticResource ComboBoxItemStyle}"/>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <Border Background="#0F172A"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,14">
                                <TextBlock Text="{Binding SelectedDriverDescription}"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           FontFamily="Segoe UI"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- ── Resolution input ── -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="SINGLETURN BITS"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#64748B"
                                               FontFamily="Segoe UI"/>
                                    <TextBlock Text="Must match the encoder hardware (e.g. 12, 18, 22)"
                                               FontSize="11"
                                               Foreground="#475569"
                                               FontFamily="Segoe UI"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBox Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding Resolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CONNECTION -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="CONNECTION"
                                       Style="{StaticResource HeaderTextStyle}"/>

                            <Border CornerRadius="8"
                                    Padding="0,14"
                                    Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"   Value="{StaticResource StatusDisconnectedBg}"/>
                                        <Setter Property="BorderBrush"  Value="{StaticResource StatusDisconnectedBorder}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background"  Value="{StaticResource StatusConnectedBg}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusConnectedBorder}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource StatusDisconnectedText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource StatusConnectedText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="Disconnected"/>
                                                <Setter Property="Foreground" Value="{StaticResource StatusDisconnectedText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Text"       Value="Connected"/>
                                                        <Setter Property="Foreground" Value="{StaticResource StatusConnectedText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <UniformGrid Rows="1" Columns="3">
                                <Button Content="Connect"
                                        Command="{Binding ConnectCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,5,0"/>
                                <Button Content="Disconnect"
                                        Command="{Binding DisconnectCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="2.5,0"/>
                                <Button Content="Reset"
                                        Command="{Binding ResetCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Margin="5,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- LOG -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="LOG"
                                       Style="{StaticResource HeaderTextStyle}"/>
                            <Border Background="{StaticResource BgTerminal}"
                                    BorderBrush="#1E293B"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,12">
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="{StaticResource TextTerminal}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </TabItem>

            <!-- ───────────────────── TAB 2: POSITION ───────────────────── -->
            <TabItem Header="Position" Style="{StaticResource ModernTabItem}">
                <StackPanel>

                    <!-- POSITION -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>

                            <TextBlock Text="POSITION"
                                       Style="{StaticResource HeaderTextStyle}"/>

                            <!-- Gauge -->
                            <controls:RadialGauge Width="320"
                                                  Height="320"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,16"
                                                  Value="{Binding Position}"/>

                            <!-- Digital readout -->
                            <Border Background="#0F172A"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="0,16"
                                    Margin="0,0,0,16">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Position, StringFormat={}{0:F3}°}"
                                               FontFamily="Consolas"
                                               FontSize="40"
                                               FontWeight="Bold"
                                               Foreground="#818CF8"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="singleturn · degrees"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               Foreground="#475569"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Reset-position buttons (Preset MT/ST = zero the position) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Reset Position"
                                        Command="{Binding PresetCommand}"
                                        Style="{StaticResource AccentButtonStyle}"/>

                                <Button Grid.Column="2"
                                        Content="Reset + Store"
                                        Command="{Binding PresetStoreCommand}"
                                        Style="{StaticResource AccentButtonStyle}"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </TabItem>

        </TabControl>

    </StackPanel>
</UserControl>
