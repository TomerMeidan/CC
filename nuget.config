<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- All packages live in the solution-level packages\ folder -->
    <add key="repositoryPath" value="packages" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
